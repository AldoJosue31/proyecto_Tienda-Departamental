{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "credentials:local": "node scripts/setup-local.mjs --credentials",
    "dev": "node scripts/secured-web-server.mjs --dev",
    "build": "next build",
    "start": "node scripts/secured-web-server.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && node --test scripts/web-client-ip.test.mjs scripts/web-mutation-origin.test.mjs",
    "test:accounts-browser": "playwright test --config playwright.accounts.config.ts",
    "test:phases-four-six-browser": "playwright test --config playwright.phases-four-six.config.ts",
    "test:phases-seven-browser": "playwright test --config playwright.phases-seven.config.ts",
    "certify:release": "node scripts/certify-release.mjs"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "chart.js": "^4.5.1",
    "ioredis": "^6.0.0",
    "leaflet": "1.9.4",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.8",
    "sileo": "^0.1.5",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
