{
  "name": "@departamental/notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "Servicio de notificaciones asíncronas para campañas y cupones.",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "amqplib": "^2.0.1",
    "dotenv": "^16.5.0",
    "helmet": "^8.1.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.15.2",
    "eslint": "^9.24.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.2"
  }
}
