# Configuración de desarrollo local. Ejecuta npm run setup:local para crear
# .env con contraseñas y llaves aleatorias independientes. No publiques .env.
# Para configurar manualmente, reemplaza cada replace_with_* y completa
# las llaves privadas vacías. Genera cada valor por separado con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEB_HOST_PORT=3000
JWT_ACCESS_SECRET=replace_with_a_new_32_byte_base64url_secret
AUTH_DB_PASSWORD=replace_with_an_auth_database_password
CATALOG_DB_PASSWORD=replace_with_a_catalog_database_password
INVENTORY_DB_PASSWORD=replace_with_an_inventory_database_password
PRICING_DB_PASSWORD=replace_with_a_pricing_database_password
ORDERS_DB_PASSWORD=replace_with_an_orders_database_password
ANALYTICS_DB_PASSWORD=replace_with_an_analytics_database_password
LOGISTICS_DB_PASSWORD=replace_with_a_logistics_database_password
CRM_DB_PASSWORD=replace_with_a_crm_database_password
NOTIFICATION_DB_PASSWORD=replace_with_a_notification_database_password
RABBITMQ_PASSWORD=replace_with_a_rabbitmq_password
# Llave base64url independiente para las llamadas privadas Orders -> Inventory.
INVENTORY_INTERNAL_SERVICE_KEY=replace_with_a_new_32_byte_base64url_secret
# Llave base64url independiente para la validación privada Orders -> Logistics.
LOGISTICS_INTERNAL_SERVICE_KEY=replace_with_a_new_32_byte_base64url_secret
# Llave independiente para que Notification consulte un contacto mínimo en Auth.
NOTIFICATION_INTERNAL_SERVICE_KEY=replace_with_a_new_32_byte_base64url_secret
CORS_ALLOWED_ORIGIN=http://localhost:3000
GATEWAY_INTERNAL_URL=http://localhost:8000
# Runtime URL passed by the server to authenticated Socket.IO screens.
PUBLIC_GATEWAY_URL=http://localhost:8000
# Optional independent base64url key shared only by Inventory and Analytics.
# If empty, both services derive a matching key from JWT_ACCESS_SECRET.
ANALYTICS_INVENTORY_SERVICE_KEY=
ANALYTICS_INVENTORY_SYNC_SECONDS=30
INVENTORY_RESERVATION_SWEEP_SECONDS=10
# Fase 10 — Google Maps: usa una llave de navegador con restricción por
# referrer y una llave separada para Routes API (solo servidor).
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_ROUTES_API_KEY=

# Solo para el entorno de desarrollo local de Compose. Nunca habilitar seeds en producción.
AUTH_NODE_ENV=development
AUTH_RUN_SEED=true
CATALOG_RUN_SEED=true
INVENTORY_NODE_ENV=development
INVENTORY_RUN_SEED=true
PRICING_NODE_ENV=development
ORDERS_NODE_ENV=development
REALTIME_NODE_ENV=development
ANALYTICS_NODE_ENV=development
LOGISTICS_NODE_ENV=development
CRM_NODE_ENV=development
NOTIFICATION_NODE_ENV=development
# En desarrollo, log simula el envío y registra SIMULATED. Para SMTP define smtp y SMTP_URL.
NOTIFICATION_DELIVERY_MODE=log
SMTP_URL=
NOTIFICATION_FROM_EMAIL=promociones@departamental.local
NOTIFICATION_RETRY_INTERVAL_SECONDS=10
NOTIFICATION_RETRY_LIMIT=3
ANALYTICS_TIMEZONE=America/Mexico_City
# Intervalo compartido de publicación de los Outbox locales de cada servicio.
OUTBOX_PUBLISH_INTERVAL_MILLISECONDS=1000
EVENT_CONSUMER_RETRY_LIMIT=5
# Cada contraseña debe tener al menos 12 caracteres; setup:local las genera.
SEED_ADMIN_PASSWORD=replace_with_a_private_admin_password
SEED_EMPLOYEE_PASSWORD=replace_with_a_private_employee_password
SEED_CUSTOMER_PASSWORD=replace_with_a_private_customer_password

# Alta de cuentas. Cada llave debe ser independiente y generada
# con crypto.randomBytes(32).toString('base64url'); nunca reutilizar JWT_ACCESS_SECRET.
ONBOARDING_EMAIL_KEY=replace_with_a_new_exact_32_byte_base64url_secret
AUTH_STATUS_INTERNAL_SERVICE_KEY=replace_with_a_new_32_byte_base64url_secret
AUTH_ONBOARDING_INTERNAL_SERVICE_KEY=replace_with_a_new_32_byte_base64url_secret
TRUSTED_BFF_IP_KEY=replace_with_a_new_32_byte_base64url_secret
# Origen fijo de enlaces y CSRF; HTTPS público, HTTP localhost solo para Auth de desarrollo.
APP_PUBLIC_ORIGIN=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=3600
AUTH_EMPLOYEE_INVITATION_TTL_SECONDS=86400
AUTH_ONBOARDING_RESEND_COOLDOWN_SECONDS=60
AUTH_ONBOARDING_RESEND_HOURLY_LIMIT=3
AUTH_ONBOARDING_IP_WINDOW_SECONDS=900
AUTH_ONBOARDING_IP_LIMIT=10
# Vacío: usar la IP de la conexión. Solo CIDR de proxies administrados por nosotros.
# El servidor propio de npm dev/start elimina headers falsificados y firma la IP.
BFF_TRUSTED_PROXY_CIDRS=

# Nueva instalación. Al actualizar una existente, conservar el hostname del
# contenedor RabbitMQ original; define el nombre antes de recrearlo.
RABBITMQ_HOSTNAME=departamental-rabbit
# Nueve redes /28 privadas para bases; usar otro prefijo para otro proyecto.
DATA_NETWORK_PREFIX=10.243
CATALOG_SERVICE_URL=http://servicio-catalogo:3002

# Private report/directory credentials. Generate independent random values.
ANALYTICS_ORDERS_REPORT_KEY=
CRM_ORDERS_REPORT_KEY=
CRM_IDENTITY_DIRECTORY_KEY=
LOGISTICS_IDENTITY_DIRECTORY_KEY=
